# ============================================================
#  SmartPresence Mobile App — Environment Variables
#  Update the HOST values to match your AWS deployment URLs
#  or use localhost for local development.
# ============================================================

# Keycloak settings
EXPO_PUBLIC_KEYCLOAK_SCHEME=https
EXPO_PUBLIC_KEYCLOAK_HOST=auth.smartpresence.dev
EXPO_PUBLIC_KEYCLOAK_PORT=443
EXPO_PUBLIC_KEYCLOAK_REALM=smartpresence
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=smartpresence-app
EXPO_PUBLIC_KEYCLOAK_REDIRECT_URI=smartpresence://auth/callback

# Backend API settings
EXPO_PUBLIC_BACKEND_SCHEME=https
EXPO_PUBLIC_BACKEND_HOST=api.smartpresence.dev
EXPO_PUBLIC_BACKEND_PORT=443
EXPO_PUBLIC_BACKEND_API_BASE_PATH=/api/v1
EXPO_PUBLIC_BACKEND_REGISTER_PATH=/auth/register
EXPO_PUBLIC_BACKEND_ME_PATH=/auth/me
EXPO_PUBLIC_BACKEND_BLE_LOOKUP_PATH=/ble/session/lookup
EXPO_PUBLIC_BACKEND_CHECKIN_PATH=/checkin
EXPO_PUBLIC_BACKEND_REGISTER_DEVICE_PATH=/checkin/register-device
