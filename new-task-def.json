{
    "containerDefinitions":  [
                                 {
                                     "name":  "smartpresence-api",
                                     "image":  "603199862265.dkr.ecr.ap-southeast-1.amazonaws.com/smartpresence-api:v1.5",
                                     "cpu":  0,
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  8080,
                                                              "hostPort":  8080,
                                                              "protocol":  "tcp"
                                                          }
                                                      ],
                                     "essential":  true,
                                     "environment":  [
                                                         {
                                                             "name":  "SERVER_PORT",
                                                             "value":  "8080"
                                                         },
                                                         {
                                                             "name":  "SPRING_DATASOURCE_USERNAME",
                                                             "value":  "spuser"
                                                         },
                                                         {
                                                             "name":  "SPRING_DATASOURCE_URL",
                                                             "value":  "jdbc:postgresql://smartpresence-prod-postgres.cfm2mqqigjrv.ap-southeast-1.rds.amazonaws.com:5432/smartpresence"
                                                         },
                                                         {
                                                             "name":  "SPRING_PROFILES_ACTIVE",
                                                             "value":  "prod"
                                                         },
                                                         {
                                                             "name":  "SPRING_JPA_HIBERNATE_DDL_AUTO",
                                                             "value":  "validate"
                                                         }
                                                     ],
                                     "mountPoints":  [

                                                     ],
                                     "volumesFrom":  [

                                                     ],
                                     "secrets":  [
                                                     {
                                                         "name":  "SPRING_DATASOURCE_PASSWORD",
                                                         "valueFrom":  "arn:aws:secretsmanager:ap-southeast-1:603199862265:secret:smartpresence/prod/db-TbT6Fo:password::"
                                                     },
                                                     {
                                                         "name":  "CLERK_SECRET_KEY",
                                                         "valueFrom":  "arn:aws:secretsmanager:ap-southeast-1:603199862265:secret:smartpresence/prod/app-XdcXWr:CLERK_SECRET_KEY::"
                                                     },
                                                     {
                                                         "name":  "ATTENDANCE_TOKEN_SECRET",
                                                         "valueFrom":  "arn:aws:secretsmanager:ap-southeast-1:603199862265:secret:smartpresence/prod/app-XdcXWr:JWT_SECRET::"
                                                     }
                                                 ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/smartpresence-prod",
                                                                              "awslogs-region":  "ap-southeast-1",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "healthCheck":  {
                                                         "command":  [
                                                                         "CMD-SHELL",
                                                                         "wget -q --spider http://localhost:8080/actuator/health || exit 1"
                                                                     ],
                                                         "interval":  30,
                                                         "timeout":  5,
                                                         "retries":  3,
                                                         "startPeriod":  60
                                                     },
                                     "systemControls":  [

                                                        ]
                                 }
                             ],
    "family":  "smartpresence-prod-task",
    "taskRoleArn":  "arn:aws:iam::603199862265:role/smartpresence-prod-ecs-task-role",
    "executionRoleArn":  "arn:aws:iam::603199862265:role/smartpresence-prod-ecs-execution-role",
    "networkMode":  "awsvpc",
    "volumes":  [

                ],
    "placementConstraints":  [

                             ],
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "512",
    "memory":  "1024"
}
