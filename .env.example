EXPO_PUBLIC_KEYCLOAK_SCHEME=http
EXPO_PUBLIC_KEYCLOAK_HOST=localhost
EXPO_PUBLIC_KEYCLOAK_PORT=8180
EXPO_PUBLIC_KEYCLOAK_REALM=smartpresence
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=smartpresence-app
EXPO_PUBLIC_KEYCLOAK_REDIRECT_URI=smartpresence://auth/callback

EXPO_PUBLIC_BACKEND_SCHEME=http
EXPO_PUBLIC_BACKEND_HOST=localhost
EXPO_PUBLIC_BACKEND_PORT=8080
EXPO_PUBLIC_BACKEND_API_BASE_PATH=/api/v1
EXPO_PUBLIC_BACKEND_REGISTER_PATH=/auth/register

