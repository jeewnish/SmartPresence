# ============================================================
#  SmartPresence — Production Environment Variables (EC2)
#  Used by: docker compose -f docker-compose.prod.yml up -d
# ============================================================

# ── Database (RDS PostgreSQL) ─────────────────────────────
DB_URL=jdbc:postgresql://smartpresence-db-dev.cp622we6ombn.ap-south-1.rds.amazonaws.com:5432/smartpresence
DB_USERNAME=smartpresence_user
DB_PASSWORD=DevPass123!Secure

# ── Keycloak DB (RDS) ─────────────────────────────────────
KC_DB_URL=jdbc:postgresql://smartpresence-db-dev.cp622we6ombn.ap-south-1.rds.amazonaws.com:5432/keycloak
KC_DB_USERNAME=smartpresence_user
KC_DB_PASSWORD=DevPass123!Secure

# ── Keycloak Admin ────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Keycloak Client Secret ────────────────────────────────
# Must match the value in keycloak/realm-export.json
KEYCLOAK_CLIENT_SECRET=smartpresence-admin-secret

# ── App Secrets ───────────────────────────────────────────
JWT_SECRET=SmartPresenceSecretKeyChangeInProductionMin64CharsLong!!
BEACON_API_KEY=sp-beacon-key-change-in-prod
